APP_ENV=local

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Kakao OAuth
# - KAKAO_REDIRECT_URI는 Kakao Developers에 등록한 URI와 반드시 동일해야 합니다.
# - KAKAO_CLIENT_SECRET은 Kakao Developers에서 Client Secret을 활성화한 경우에만 입력합니다.
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
# 실제 카카오 계정 로그인을 기본값으로 사용합니다.
# 개발용 가짜 카카오 계정은 로컬 테스트가 꼭 필요할 때만 true로 바꾸세요.
KAKAO_ALLOW_DEV_LOGIN=false

# Internal auth security peppers (do NOT hardcode in code)
AUTH_SHADOW_PASSWORD_PEPPER=CHANGE_ME_TO_LONG_RANDOM_SECRET
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_LONG_RANDOM_SECRET

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_LANGUAGE=ko
OPENAI_STT_PROMPT=
OPENAI_MEMORY_MODEL=gpt-4.1-mini
OPENAI_MEMORY_PROMPT=
OPENAI_CHAPTER_MODEL=gpt-4.1-mini
OPENAI_CHAPTER_PROMPT=
OPENAI_SAFETY_MODEL=gpt-4.1-mini
OPENAI_SAFETY_PROMPT=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_PUBLIC_PATH=/generated-audio
OPENAI_TTS_OUTPUT_DIR=.generated-audio
OPENAI_TTS_INSTRUCTIONS=
